# Copy this file to .streamlit/secrets.toml (locally) or paste into
# Streamlit Cloud → App → Settings → Secrets. Never commit secrets.toml.

BRAND_NAME   = "Her Brand"
APP_PASSWORD = "choose-a-strong-password"

# Supabase → Project → Connect → "Session pooler"
SUPABASE_HOST     = "aws-0-ap-south-1.pooler.supabase.com"
SUPABASE_PORT     = 5432
SUPABASE_USER     = "postgres.xxxxxxxxxxxxxxxxxxxx"
SUPABASE_PASSWORD = ""
SUPABASE_DB       = "postgres"

# Unicommerce API user (for uc_sync.py)
UC_TENANT   = "herbrand"          # the part before .unicommerce.com
UC_USERNAME = ""
UC_PASSWORD = ""

# Google Sheets (for sheets_sync.py) — the long id in the sheet URL
MASTER_SHEET_ID     = ""
MASTER_SHEET_TAB    = ""
PRODUCTION_SHEET_ID = ""
PRODUCTION_SHEET_TAB = ""

# [gcp_service_account]
# type = "service_account"
# project_id = "..."
# private_key_id = "..."
# private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# client_email = "...@....iam.gserviceaccount.com"
# client_id = "..."
# token_uri = "https://oauth2.googleapis.com/token"
